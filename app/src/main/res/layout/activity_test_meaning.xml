<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/ic_chevron_left"
            android:paddingStart="26dp"
            android:paddingTop="15dp"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/trend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/back"
            app:layout_constraintBottom_toTopOf="@id/disclaimer"
            android:src="@drawable/ic_trend_line"/>

        <TextView
            android:id="@+id/disclaimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disclaimer"
            app:layout_constraintTop_toBottomOf="@id/trend"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/disclaimerBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Like many health tests, the movement analysis provided by this app only captures a snippet of your state each day. For instance, your energy level in the morning might be different from your energy level at night. But why still take the test? These data will provide long term reference information for doctors than the short visit."
            app:layout_constraintTop_toBottomOf="@id/disclaimer"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

        <TextView
            android:id="@+id/howToViewValues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How To View Values?"
            app:layout_constraintTop_toBottomOf="@id/disclaimerBody"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/HowToViewValuesBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notice the range of values instead of the individual measurement: a cluster of values around the same point may indicate stability. But these tests do not replace clinical assessments."
            app:layout_constraintTop_toBottomOf="@id/howToViewValues"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

        <TextView
            android:id="@+id/balanceTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balance (Baseline)"
            app:layout_constraintTop_toBottomOf="@id/HowToViewValuesBody"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/balanceBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You stand still with your eyes open, feet together, while the app tracks your center of mass (COM) — the point your balance is organized around. Nobody stands perfectly still: everyone sways slightly, and this test measures that sway. It is your baseline — the Dual Task and Sensory Ataxia results are judged against it."
            app:layout_constraintTop_toBottomOf="@id/balanceTest"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

        <TextView
            android:id="@+id/dualTaskTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dual Task"
            app:layout_constraintTop_toBottomOf="@id/balanceBody"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/dualTaskBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You stand the same way as the baseline test, but now you also say the ink color of each word out loud (the Stroop test). Thinking and speaking compete for the same attention that balance uses, so sway usually grows. The increase compared to your baseline is the dual-task cost: it shows how much your balance depends on attention, the way it must in busy real-world situations."
            app:layout_constraintTop_toBottomOf="@id/dualTaskTest"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

        <TextView
            android:id="@+id/sensoryAtaxiaTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensory Ataxia"
            app:layout_constraintTop_toBottomOf="@id/dualTaskBody"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/sensoryAtaxiaBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You stand the same way with your eyes closed. Without vision, balance has to rely on proprioception — the position sense from your muscles and joints — and on the vestibular system in your inner ear. If your sway grows a lot when your eyes close, your balance is leaning heavily on vision (doctors call this the Romberg principle). A small change means the other senses are carrying their share."
            app:layout_constraintTop_toBottomOf="@id/sensoryAtaxiaTest"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

        <TextView
            android:id="@+id/swayMetricsTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What the Sway Metrics Mean"
            app:layout_constraintTop_toBottomOf="@id/sensoryAtaxiaBody"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/swayMetricsBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sway Area (mm²): the size of the area your COM covers during the test — the 95% confidence ellipse. Smaller usually means steadier.\n\nSway Path Length (mm): the total distance your COM travels during the test.\n\nMean Velocity (mm/s): path length divided by time — how fast your COM moves on average. It is often the most sensitive sway measure.\n\nRMS AP (mm): your typical sway size front-to-back (anteroposterior).\n\nRMS ML (mm): your typical sway size side-to-side (mediolateral) — the direction most linked to fall risk.\n\nDual-Task Cost (%): how much a metric changed from the baseline test to a harder condition. A positive value means sway grew under the added challenge."
            app:layout_constraintTop_toBottomOf="@id/swayMetricsTest"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

        <TextView
            android:id="@+id/walkingSpeedTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Walking Speed"
            app:layout_constraintTop_toBottomOf="@id/swayMetricsBody"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/walkingSpeedBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The range of walking speed may help you find a balance between rest and movement"
            app:layout_constraintTop_toBottomOf="@id/walkingSpeedTest"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

        <TextView
            android:id="@+id/enduranceTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Endurance"
            app:layout_constraintTop_toBottomOf="@id/walkingSpeedBody"
            app:layout_constraintStart_toStartOf="parent"
            android:fontFamily="@font/profile_pro_black"
            android:textSize="18sp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/enduranceBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Endurance measures the distance that you walk in a timed test."
            app:layout_constraintTop_toBottomOf="@id/enduranceTest"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            android:paddingBottom="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:layout_marginStart="30dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
