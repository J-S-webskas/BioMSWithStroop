<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_chevron_left"
                android:paddingStart="26dp"
                android:paddingTop="15dp"
                android:background="@android:color/transparent"/>

            <CheckBox
                android:id="@+id/markDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark Distance"
                android:fontFamily="@font/profile_pro_black"
                android:textSize="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="50dp"
                android:layout_marginStart="30dp"/>

            <TextView
                android:id="@+id/distanceBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark a spot where you are in full view to the camera\n\nMeasure the distance from your feet to the camera and update the distance accordingly in the prompt that will pop up after you click the Next button in Start Test on Record page. Make sure the room is lit properly: bright, even light on you, and no strong light behind you shining into the camera."
                app:layout_constraintTop_toBottomOf="@id/markDistance"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="30dp"
                android:fontFamily="@font/profile_pro"
                android:textSize="16sp"
                android:layout_marginStart="30dp" />

            <ImageView
                android:id="@+id/someoneRecord"
                android:layout_width="wrap_content"
                android:layout_height="500dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/distanceBody"
                android:layout_marginTop="10dp"
                android:src="@drawable/prop_record"
                android:adjustViewBounds="true"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:focusable="true"
                android:focusableInTouchMode="true"/>

            <CheckBox
                android:id="@+id/propRecording"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:fontFamily="@font/profile_pro_black"
                android:text="Find a Vertical Surface"
                android:textSize="20dp"
                android:layout_marginTop="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/someoneRecord"
                app:layout_constraintBaseline_toBottomOf="parent"/>

            <TextView
                android:id="@+id/surfaceBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Some options to prop up the camera include a table and books, or a music stand. The surface must be firm and hold the camera steadily"
                app:layout_constraintTop_toBottomOf="@id/propRecording"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="30dp"
                android:fontFamily="@font/profile_pro"
                android:textSize="16sp"
                android:layout_marginStart="30dp" />

            <ImageView
                android:id="@+id/propRecord"
                android:layout_width="wrap_content"
                android:layout_height="500dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/someone_record"
                android:adjustViewBounds="true"
                app:layout_constraintTop_toBottomOf="@id/surfaceBody"
                android:layout_marginTop="10dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"/>

            <TextView
                android:id="@+id/previewModeNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:fontFamily="@font/profile_pro_medi"
                android:text="Click next to see the camera in preview test mode. \nOnly proceed after you've completed the steps above and know what to do."
                android:textSize="16sp"
                android:layout_marginTop="40dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/DualTask"
                app:layout_constraintBaseline_toBottomOf="parent"/>

            <Button
                android:id="@+id/next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next"
                android:textSize="16sp"
                android:layout_marginBottom="20dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/profile_pro_medi"
                android:backgroundTint="@color/black"
                android:textColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/previewModeNext"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <CheckBox
                android:id="@+id/walk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stand feet together\nHands clamped to your side\nFace the Camera (30 seconds)"
                android:fontFamily="@font/profile_pro_black"
                android:textSize="20dp"
                android:maxLines="3"
                app:layout_constraintTop_toBottomOf="@id/propRecord"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="50dp"
                android:layout_marginStart="30dp"/>

            <TextView
                android:id="@+id/SwayAreaAndBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• If you want to record Sway Area and Balance:\nFollow the bolded words in the title above"
                app:layout_constraintTop_toBottomOf="@id/walk"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:fontFamily="@font/profile_pro"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/SensoryAtaxia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• If you want to record Sensory Ataxia: \nclose your eyes and follow the bolded words of the title above"
                app:layout_constraintTop_toBottomOf="@id/SwayAreaAndBalance"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="30dp"
                android:fontFamily="@font/profile_pro"
                android:textSize="16sp"
                android:layout_marginStart="30dp"/>

            <TextView
                android:id="@+id/DualTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• If you want to record Dual Task:\n SAY OUTLOUD the INK COLOR of the words that will display on the screen once test starts (also available in preview mode to practice). \n\nFor instance, if the word says blue, but it is displayed in red INK, say red. The audio detecter will automatically move on to the next word after it detects the word you spoke.\n\nFollow the bolded words in the title above."
                app:layout_constraintTop_toBottomOf="@id/SensoryAtaxia"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="30dp"
                android:fontFamily="@font/profile_pro"
                android:textSize="16sp"
                android:layout_marginStart="30dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>