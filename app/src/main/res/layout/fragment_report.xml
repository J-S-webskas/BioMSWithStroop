<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="Report"
            app:titleTextAppearance="@style/ToolbarTitleText" />

        <Button
            android:id="@+id/createNewReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/profile_pro_medi"
            android:text="New"
            android:textSize="18sp"
            android:backgroundTint="#FB3737"/>

        <TextView
            android:id="@+id/noData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Finish a recording to create data!"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:fontFamily="@font/profile_pro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/endIsMostAccurate" />

        <TextView
            android:id="@+id/endIsMostAccurate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/profile_pro"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:textAlignment="center"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:text="The topmost report at the end of each day will always reflects your actual tracked symptoms"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/createNewReport"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/noData"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <Button
            android:id="@+id/btn_delete_report"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#D32F2F"
            app:layout_constraintBottom_toBottomOf="@id/createNewReport"
            android:text="Delete"
            android:fontFamily="@font/profile_pro_medi"
            android:textSize="18sp"
            android:layout_marginEnd="10dp"
            android:textColor="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout_editor_absoluteY="618dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>