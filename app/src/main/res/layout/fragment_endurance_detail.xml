<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F5F7"
        android:padding="8dp">

        <!-- Top Card with Horizontal Scrollable Chart -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Chart Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="#1ec688"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/trending_up"
                        app:tint="@color/white"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Endurance Trend Analysis"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swipe"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:padding="4dp"
                        android:background="#26FFFFFF"
                        android:paddingHorizontal="8dp"
                        android:drawableEnd="@drawable/arrow_forward_icon" />

                </LinearLayout>

                <!-- Horizontally Scrollable Chart Area -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:fadingEdgeLength="32dp"
                    android:requiresFadingEdge="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <!-- MPAndroidChart Gradient Area Chart -->
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/areaChart"
                            android:layout_width="1000dp"
                            android:layout_height="match_parent"
                            android:minHeight="200dp"
                            android:padding="12dp"
                            tools:ignore="ContentDescription" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Time Range Indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:background="#F8F9FA"
                    android:gravity="center">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="#1ec688"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/timeRangeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last 30 days | Updated: Today 10:30 AM"
                        android:textColor="#666666"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Bottom Card with Detailed Description -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Description Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/info_icon"
                        app:tint="#1ec688"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Analysis &amp; Insights"
                        android:textColor="#333333"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginHorizontal="16dp"/>

                <!-- Scrollable Description Content -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/chartDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="**Heart Rate Variability Analysis**\n\nThis gradient area chart visualizes your heart rate patterns over the selected time period. The color gradient represents intensity, transitioning from cool blue (resting) to warm red (peak activity).\n\n🔍 **Key Observations:**\n• **Average Resting HR:** 65 BPM\n• **Peak Exercise HR:** 120 BPM\n• **Recovery Rate:** 15 minutes to baseline\n• **Variability Index:** 45 ms (Healthy range)\n\n💡 **Clinical Significance:**\nHigher heart rate variability generally indicates better cardiovascular fitness and stress resilience. The gradient visualization helps identify:\n1. Exercise intensity patterns\n2. Stress response trends\n3. Recovery efficiency\n4. Sleep quality indicators\n\n📈 **Trend Interpretation:**\n- Consistent morning peaks suggest regular exercise\n- Evening dips correspond with relaxation periods\n- Weekend variations show lifestyle impact\n\n⚠️ **When to Consult:**\nPersistent elevated resting rates (>80 BPM) or minimal variability may warrant medical consultation.\n\n*Data updated in real-time from connected biometric sensors.*"
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="#444444"
                        android:textIsSelectable="true"
                        android:paddingBottom="24dp"/>

                </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</layout>