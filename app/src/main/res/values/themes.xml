<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.MyAppication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Set status bar to match your background color -->
        <item name="android:statusBarColor">@color/design_default_color_secondary</item>

        <!-- Make status bar icons dark (if your secondary color is light)
             or light (if your secondary color is dark) -->
        <item name="android:windowLightStatusBar">true</item>  <!-- Change to false if color is dark -->

        <!-- Optional: Set navigation bar color to match -->
        <item name="android:navigationBarColor">@color/design_default_color_secondary</item>

        <!-- Keep your other theme settings -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.MyAppication" parent="Base.Theme.MyAppication" />
</resources>