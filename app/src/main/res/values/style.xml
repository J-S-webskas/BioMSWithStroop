<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BoldToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="BoldTabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="Tittle">textsize</style>

    <style name="TittleSize">
        <item name = "android:textSize">28sp</item>
    </style>
    <style name="ToolbarTitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/profile_pro_black</item>
        <!-- Optionally add font weight -->
    </style>
    <style name="BioMSTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/profile_pro_bold</item>
        <!-- Optionally add font weight -->
    </style>
</resources>